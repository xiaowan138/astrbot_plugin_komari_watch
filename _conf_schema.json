{
  "komari_url": {"type": "string", "description": "Komari 服务器地址", "hint": "例如 https://status.example.com", "default": ""},
  "komari_token": {"type": "string", "description": "API Token", "hint": "私有站点填写 API Key 或 Session Token", "default": ""},
  "image_output": {"type": "bool", "description": "状态以图片发送", "hint": "关闭后使用兼容性更好的纯文本消息", "default": true},
  "image_width": {"type": "int", "description": "状态图片宽度", "hint": "推荐 800 到 1000 像素", "default": 900, "minimum": 500, "maximum": 1600},
  "poll_interval": {"type": "int", "description": "轮询间隔（秒）", "hint": "建议 60 秒以上", "default": 60, "minimum": 15, "maximum": 3600},
  "offline_grace_cycles": {"type": "int", "description": "离线确认周期", "hint": "连续无心跳多少次才推送离线告警", "default": 2, "minimum": 1, "maximum": 10},
  "cpu_threshold": {"type": "float", "description": "CPU 告警阈值（%）", "default": 90, "minimum": 1, "maximum": 100},
  "memory_threshold": {"type": "float", "description": "内存告警阈值（%）", "default": 90, "minimum": 1, "maximum": 100},
  "disk_threshold": {"type": "float", "description": "磁盘告警阈值（%）", "default": 90, "minimum": 1, "maximum": 100},
  "high_load_cycles": {"type": "int", "description": "高负载确认周期", "hint": "连续超阈值多少次才推送", "default": 2, "minimum": 1, "maximum": 10},
  "alert_cooldown": {"type": "int", "description": "告警冷却时间（秒）", "default": 1800, "minimum": 0, "maximum": 86400},
  "notify_recovery": {"type": "bool", "description": "推送恢复通知", "default": true},
  "request_timeout": {"type": "int", "description": "请求超时（秒）", "default": 10, "minimum": 3, "maximum": 60},
  "filter_mode": {"type": "string", "description": "节点过滤模式", "hint": "none=不过滤；allow=只监控列表中节点；deny=排除列表中节点", "default": "none"},
  "filter_nodes": {"type": "string", "description": "过滤/白名单节点", "hint": "节点名，多个用英文逗号分隔，支持子串匹配", "default": ""},
  "status_report_interval": {"type": "int", "description": "定时状态推送间隔（小时）", "hint": "大于 0 时按该间隔向绑定会话推送状态卡片，0 表示关闭", "default": 0, "minimum": 0, "maximum": 720},
  "status_report_time": {"type": "string", "description": "每天定时推送时刻", "hint": "本地时间 HH:MM（如 09:00），多个时刻用英文逗号分隔（如 09:00,18:00），到点自动推送状态卡片，留空不启用", "default": ""},
  "prune_missing_cycles": {"type": "int", "description": "节点清理周期", "hint": "节点从服务器消失多少周期后清理其监控状态", "default": 5, "minimum": 1, "maximum": 100},
  "panel_fail_cycles": {"type": "int", "description": "面板故障告警周期", "hint": "连续多少次检查失败后推送面板不可达告警，恢复时自动通知，0 表示关闭", "default": 3, "minimum": 0, "maximum": 10},
  "notify_restart": {"type": "bool", "description": "推送节点重启通知", "hint": "检测到运行时间回退时推送提醒", "default": true},
  "long_offline_remind_hours": {"type": "int", "description": "长期离线提醒（小时）", "hint": "节点离线超过该时长后每日提醒一次，0 表示关闭", "default": 0, "minimum": 0, "maximum": 720},
  "fraction_metrics": {"type": "string", "description": "按 0-1 小数上报的指标", "hint": "这些指标会乘 100 转为百分比，多个用英文逗号分隔（cpu,memory,disk,gpu），留空表示不换算", "default": "cpu,memory,disk"},
  "expire_remind_days": {"type": "int", "description": "到期提醒（天）", "hint": "节点到期前多少天开始每日提醒一次，续费后自动重新计时，0 表示关闭", "default": 3, "minimum": 0, "maximum": 365},
  "traffic_alert_percent": {"type": "float", "description": "流量限额告警阈值（%）", "hint": "流量使用率超过该百分比时告警，回落后推送恢复通知；面板未提供累计流量时自动跳过，0 表示关闭", "default": 0, "minimum": 0, "maximum": 100}
}